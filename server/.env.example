# Server porti
PORT=5000
# development | production | test
NODE_ENV=development
# MongoDB ulanish satri (lokal MongoDB yoki MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/smart-study-planner
# JWT imzolash kaliti — production'da MAJBURIY (uzun tasodifiy satr qo'ying)
JWT_SECRET=change_me_to_a_long_random_string
# Token amal qilish muddati
JWT_EXPIRES_IN=7d
# Ruxsat etilgan frontend manzil(lar)i, vergul bilan ajratiladi
CLIENT_ORIGIN=http://localhost:5173
# Foydalanuvchilar jadvali bo'sh bo'lsa, ishga tushishda demo ma'lumotlarni yaratish
SEED_DEMO=true

# --- Ixtiyoriy sozlamalar ---
# client/dist mavjud bo'lsa ham uni server orqali bermaslik uchun: SERVE_CLIENT=false
# SERVE_CLIENT=true
# Faollik statistikasi (kunlar) uchun vaqt zonasi
# APP_TIMEZONE=Asia/Tashkent
# Proksi orqasida (masalan, Render) ishlaganda: 1 (production'da standart)
# TRUST_PROXY=1
